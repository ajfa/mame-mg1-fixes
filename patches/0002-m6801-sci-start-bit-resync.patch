@@ -163,6 +163,7 @@ protected:
 
 	u8 m_trcsr, m_rmcr, m_rdr, m_tdr, m_rsr, m_tshr;
 	int m_rxbits, m_txbits, m_txstate, m_trcsr_read_tdre, m_trcsr_read_orfe, m_trcsr_read_rdrf, m_tx, m_sci_clocks;
+	int m_sci_rx_last = 1;
 	bool m_use_ext_serclock;
 
 	u8 m_latch09;
